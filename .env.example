# ScamLens Bharat Environment Variables Template

# Gemini API Key for AI Analysis & Vision OCR
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional Database (Opt-in analytics / feedback)
# DATABASE_URL=postgresql://user:password@localhost:5432/scamlens
